# ---- Public (safe for the browser) ----
NEXT_PUBLIC_SITE_URL=http://localhost:3000
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# ---- Server only — never prefix with NEXT_PUBLIC_ ----
SUPABASE_SERVICE_ROLE_KEY=

# Travel suppliers (PRD §7, §12.2). "mock" = sandbox data for development.
FLIGHT_PROVIDER=mock
HOTEL_PROVIDER=mock
# Set to true once a live supplier is connected, so demo data can never be served.
DISABLE_MOCK_SUPPLIERS=false
# Example once a supplier is contracted:
# SUPPLIER_TBO_API_KEY=
# SUPPLIER_TBO_API_SECRET=

# Payments (PRD §8.7). "mock" = simulated gateway for development.
PAYMENT_GATEWAY=mock
DISABLE_MOCK_PAYMENTS=false

# Notifications (PRD §8.9)
EMAIL_PROVIDER=console
WHATSAPP_ENABLED=false
