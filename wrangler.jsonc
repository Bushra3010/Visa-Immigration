{
  "$schema": "node_modules/wrangler/config-schema.json",
  "main": ".open-next/worker.js",
  "name": "newvisa",
  "compatibility_date": "2026-11-01",
  "compatibility_flags": ["nodejs_compat", "global_fetch_strictly_public"],
  // Keep the *.workers.dev address live; it switches off by default once routes exist.
  "workers_dev": true,
  "preview_urls": false,
  // Serve the site on newvisa.io (Cloudflare creates the DNS records and certificates).
  "routes": [
    { "pattern": "newvisa.io", "custom_domain": true },
    { "pattern": "www.newvisa.io", "custom_domain": true }
  ],
  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS"
  },
  "services": [
    // Self-reference binding; the service name must match the worker name.
    { "binding": "WORKER_SELF_REFERENCE", "service": "newvisa" }
  ],
  "images": {
    // Image optimization for next/image.
    "binding": "IMAGES"
  }
}
